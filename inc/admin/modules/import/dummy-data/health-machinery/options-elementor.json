round-size: 200% 100%;\r\n    transition: .5s;\r\n    border: 2px solid #000;\r\n    cursor: pointer;\r\n}\r\n\r\n.sec-three .vision:hover {\r\n    background-position: left;\r\n}\r\n\r\n.sec-three .vision:hover h2,\r\n.sec-three .vision:hover p{\r\n    color: #000;\r\n    transition: 0.5s;\r\n}\r\n\r\n.sec-three .mission{\r\n    letter-spacing: 1px;\r\n    background: linear-gradient(to left, #fff 50%, #F2A442 50%) right;\r\n    background-size: 200% 100%;\r\n    transition: .5s;\r\n    border: 2px solid #000;\r\n    cursor: pointer;\r\n}\r\n\r\n.sec-three .mission:hover {\r\n    background-position: left;\r\n}\r\n\r\n.sec-three .mission:hover h2,\r\n.sec-three .mission:hover p{\r\n    color: #fff;\r\n    transition: 0.5s;\r\n}\r\n\r\n\/* single product page *\/\r\n\r\nbutton.single_add_to_cart_button.button.alt {\r\n    background-color: #000;\r\n}\r\n\r\n.popup-quick-view tr.woocommerce-product-attributes-item.woocommerce-product-attributes-item--attribute_pa_color{\r\n    display: none;\r\n}\r\n\r\n\/* footer *\/\r\n\r\n.wd-prefooter {\r\n    padding-bottom: 0 !important;\r\n}\r\n\r\n.footer fieldset.hidden-fields-container{\r\n    display: none;\r\n}\r\n\r\n.footer form label {\r\n    color: #fff !important;\r\n    text-transform: capitalize;\r\n    display: flex;\r\n}\r\n\r\n.footer input.wpcf7-form-control.wpcf7-email.wpcf7-validates-as-required.wpcf7-text.wpcf7-validates-as-email{\r\n    border-color: #fff;\r\n    border-radius: 5px 0 0 5px;\r\n}\r\n\r\n.footer input.wpcf7-form-control.wpcf7-submit.has-spinner {\r\n    background-color: #ff8000;\r\n    color: #fff;\r\n    font-size: 16px;\r\n    border-radius: 0px 5px 5px 0px;\r\n}\r\n\r\n\r\n.copyrights-wrapper.copyrights-centered {\r\n    background-color: #000000;\r\n    color: #fff;\r\n}\r\n.copyrights-wrapper.copyrights-centered a{\r\n    color: #fff;\r\n}\r\n\r\n\/*Contact Us Form*\/\r\n.half-row {\r\n    display: flex;\r\n    gap: 20px;\r\n}\r\n\r\n.half-field {\r\n    width: 50%;\r\n}\r\n\r\n.half-field input {\r\n    width: 100%;\r\n}\r\n\r\n.contact-us-form input.wpcf7-form-control,\r\n.contact-us-form textarea.wpcf7-form-control.wpcf7-textarea{\r\n    background-color: #fff;\r\n    color: #000;\r\n}\r\n\r\n.contact-us-form .cf7-btn {\r\n    background-color: #000 !important;\r\n    color: #fff !important;\r\n    border-radius: 5px;\r\n    padding: 15px;\r\n    font-size: 16px;\r\n    letter-spacing: 1px;\r\n}\r\n\r\n@media (max-width: 768px) {\r\n    .half-row {\r\n        flex-direction: column;\r\n    }\r\n\r\n    .half-field {\r\n        width: 100%;\r\n    }\r\n}\r\n\r\n\/*--- SideBar Margin---*\/\r\n.sidebar-container {\r\n    margin-top: 40px;\r\n}\r\n\r\n\/*--- Blog Content Margin---*\/\r\n .single-post .site-content {\r\n    padding-top: 40px;\r\n}\r\n\/*--- Comment Area Margin---*\/\r\n.comments-area .comment-respond {\r\n    margin-bottom: 30px;\r\n}\r\n\/*--- MyAccount Content Area Margin---*\/\r\n.woocommerce-MyAccount-content {\r\n    margin-bottom: 20px;\r\n}","css_desktop":"","css_tablet":"","css_wide_mobile":"","css_mobile":"","css_backend":"","custom_js":"","js_ready":"","sticky_social":"0","sticky_social_type":"follow","sticky_social_position":"right","social_follow_notice":"","fb_link":"#","twitter_link":"","isntagram_link":"#","pinterest_link":"","youtube_link":"","tumblr_link":"","linkedin_link":"#","vimeo_link":"","flickr_link":"","github_link":"","dribbble_link":"","behance_link":"","soundcloud_link":"","spotify_link":"","ok_link":"","vk_link":"","whatsapp_link":"","snapchat_link":"","tg_link":"","tiktok_link":"","discord_link":"","social_email_links":"0","social_share_notice":"","share_fb":"1","share_twitter":"1","share_pinterest":"0","share_linkedin":"1","share_ok":"0","share_whatsapp":"0","share_vk":"0","share_tg":"0","share_viber":"0","share_email":"0","mobile_optimization":"0","load_text_domain":"1","disable_gutenberg_css":"0","disable_gutenberg_backend_css":"0","styles_always_use":"","styles_not_use":"","disable_owl_mobile_device